# Copy this file to deploy/.env and replace the example values. Never commit .env.

# The domain (or subdomain) whose DNS A record points at this VPS. No https://, no trailing slash.
SB_DOMAIN=play.example.com

# Web page origins allowed to connect to the game server, comma-separated.
# An origin is scheme + host (+ port if non-standard), with no path.
# For GitHub Pages that is https://YOUR-GITHUB-USERNAME.github.io (lowercase, no /repo-name).
SB_ALLOWED_ORIGINS=https://your-github-username.github.io
