{
    "_comment": "Which raw Kenney file becomes which shipped sound (read by tools/process-audio.mjs; the set names and variant counts must equal SAMPLE_SETS in client/src/audio-logic.ts, a test checks it). 'match' are regular expressions tried in order against the file name without its extension; the first 'n' distinct files found become variants 1..n. 'maxDur' cuts the sound (s, with a 30 ms fade), 'pitch' is a playback-speed factor, 'lp' a low-pass in Hz, 'gain' dB applied after peak normalisation. These file names were written from memory of the Kenney packs BEFORE the packs were available: check them against the real files, fix the patterns and rerun.",
    "step_concrete": { "n": 4, "match": ["^footstep_concrete_00[0-4]$"], "maxDur": 0.35 },
    "step_metal": { "n": 4, "match": ["^impactPlate_light_00[0-4]$", "^impactMetal_light_00[0-4]$"], "maxDur": 0.3, "pitch": 0.9, "lp": 7000 },
    "step_wood": { "n": 4, "match": ["^footstep_wood_00[0-4]$"], "maxDur": 0.35 },
    "impact_concrete": { "n": 3, "match": ["^impactMining_00[0-4]$", "^impactGeneric_light_00[0-4]$"], "maxDur": 0.25 },
    "impact_metal": { "n": 3, "match": ["^impactMetal_medium_00[0-4]$", "^impactMetal_light_00[0-4]$"], "maxDur": 0.4 },
    "impact_wood": { "n": 3, "match": ["^impactWood_light_00[0-4]$", "^impactWood_medium_00[0-4]$"], "maxDur": 0.25 },
    "shot_rifle_loud": { "n": 2, "match": ["^impactPunch_heavy_00[0-4]$"], "maxDur": 0.45, "pitch": 0.8 },
    "shot_pistol_loud": { "n": 2, "match": ["^impactPunch_medium_00[0-4]$"], "maxDur": 0.35 },
    "shot_rifle_supp": { "n": 1, "match": ["^impactSoft_heavy_00[0-4]$"], "maxDur": 0.25, "pitch": 0.9 },
    "shot_pistol_supp": { "n": 1, "match": ["^impactSoft_medium_00[0-4]$"], "maxDur": 0.2 },
    "reload_rifle_out": { "n": 1, "match": ["^metalClick$", "^metalLatch$"], "maxDur": 0.25 },
    "reload_rifle_in": { "n": 1, "match": ["^metalLatch$", "^impactMetal_heavy_00[0-4]$"], "maxDur": 0.3 },
    "reload_rifle_bolt": { "n": 1, "match": ["^impactMetal_heavy_00[0-4]$", "^doorClose_1$"], "maxDur": 0.35 },
    "reload_pistol_out": { "n": 1, "match": ["^metalClick$"], "maxDur": 0.2, "pitch": 1.1 },
    "reload_pistol_in": { "n": 1, "match": ["^metalLatch$"], "maxDur": 0.25, "pitch": 1.1 },
    "reload_pistol_slide": { "n": 1, "match": ["^impactMetal_light_00[0-4]$"], "maxDur": 0.25, "pitch": 1.1 },
    "knife_windup": { "n": 1, "match": ["^drawKnife[1-3]$"], "maxDur": 0.3 },
    "knife_slash": { "n": 2, "match": ["^knifeSlice2?$", "^drawKnife[1-3]$"], "maxDur": 0.3 },
    "knife_hit": { "n": 2, "match": ["^impactSoft_heavy_00[0-4]$", "^impactPunch_medium_00[0-4]$"], "maxDur": 0.25 },
    "bomb_beep": { "n": 1, "match": ["^tone1$", "^pepSound1$"], "maxDur": 0.12 },
    "bomb_planted": { "n": 1, "match": ["^threeTone1$", "^twoTone1$"], "maxDur": 1.0 },
    "bomb_defused": { "n": 1, "match": ["^highUp$", "^phaserUp3$"], "maxDur": 1.0 },
    "explosion": { "n": 1, "match": ["^explosionCrunch_00[0-4]$", "^lowFrequency_explosion_00[01]$"], "maxDur": 2.2 },
    "bomb_drop": { "n": 1, "match": ["^impactGeneric_heavy_00[0-4]$", "^impactSoft_heavy_00[0-4]$"], "maxDur": 0.3 },
    "bomb_pickup": { "n": 1, "match": ["^beltHandle1$", "^handleSmallLeather$"], "maxDur": 0.35 },
    "hit_body": { "n": 1, "match": ["^tick_001$", "^click_001$"], "maxDur": 0.12 },
    "hit_head": { "n": 1, "match": ["^tick_002$", "^click_002$"], "maxDur": 0.12 },
    "hit_kill": { "n": 1, "match": ["^confirmation_001$", "^select_001$"], "maxDur": 0.35 },
    "dry": { "n": 1, "match": ["^metalClick$", "^click_005$"], "maxDur": 0.12 },
    "switch_rifle": { "n": 1, "match": ["^handleSmallLeather2$", "^beltHandle2$"], "maxDur": 0.4 },
    "switch_pistol": { "n": 1, "match": ["^handleSmallLeather$", "^beltHandle1$"], "maxDur": 0.3 },
    "switch_knife": { "n": 1, "match": ["^drawKnife[1-3]$"], "maxDur": 0.3 },
    "ui_click": { "n": 2, "match": ["^click_00[13]$", "^click_00[1-5]$", "^select_00[1-8]$"], "maxDur": 0.1 }
}
